# Caminho onde o Cursor lê as skills pessoais NESTA máquina
# OBRIGATÓRIO em ambientes diferentes (ex.: PC local vs Coders) — cada um tem seu .env
# Windows (exemplo): C:\Users\seu-user\.cursor\skills
# Linux home (exemplo): /home/seu-user/.cursor/skills
# Coders: path do Cursor no servidor (nao e o mesmo do PC) — preencher aqui
# Se vazio: fallback $HOME/.cursor/skills
SKILLS_DEST_PATH=

# ── ClickUp (compartilhado: project-context-doc + po-techlead-scrum) ──
# npm run sync gera clickup.env em cada skill a partir destas vars
CLICKUP_API_TOKEN=
CLICKUP_WORKSPACE_ID=90131082033

# Listas — Space DEV | Projetos
CLICKUP_LIST_ESTEIRA=901326818223
CLICKUP_LIST_IMEDIATAS=901326981587

# Assignees
CLICKUP_ASSIGNEE_RICARDO=72158089

# Custom task types (GET /team/{id}/custom_item)
# Esteira usa tipo Task padrao (sem custom_item_id)
# Imediatas usa 0- IMEDIATA
CLICKUP_CUSTOM_TYPE_IMEDIATA=1016

# Status na Esteira ao criar (nome exato da API)
CLICKUP_STATUS_ESTEIRA_PBI=pbi (bugs) e tasks

# Custom field "Projeto" (dropdown)
CLICKUP_CF_PROJETO=912a0e72-2aa0-4fc4-b930-4a25c4b4edb7
CLICKUP_CF_PROJETO_OPTION_BATEU=b19f3971-f07e-4df5-ab31-1e4ead598d44
CLICKUP_CF_PROJETO_ORDERINDEX_BATEU=3

# git pull antes de sincronizar (true/false). Default: true
GIT_PULL=true

# ── Apidog (token da CONTA; IDs de projeto NÃO entram aqui) ──
# Docs da API: https://openapi.apidog.io/
# Project ID e moduleId: perguntar sempre (mudam por produto).
APIDOG_ACCESS_TOKEN=
APIDOG_API_BASE=https://api.apidog.com
APIDOG_API_VERSION=2024-03-28
