    "size": {
      "sm": { "$type": "dimension", "$value": "16px" },
      "md": { "$type": "dimension", "$value": "20px" },
      "lg": { "$type": "dimension", "$value": "24px" }
    },
    "stroke": { "$value": 2 }
  },
  "motion": {
    "instant": {
      "duration": { "$type": "duration", "$value": "0ms" }
    },
    "fast": {
      "duration": { "$type": "duration", "$value": "150ms" },
      "easing": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] }
    },
    "base": {
      "duration": { "$type": "duration", "$value": "200ms" },
      "easing": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] }
    },
    "slow": {
      "duration": { "$type": "duration", "$value": "220ms" },
      "easing": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] }
    },
    "reduced": {
      "$value": "prefers-reduced-motion: reduce → animation:none; game-badge-chip sem expand"
    }
  },
  "elevation": {
    "shadow-card": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "2px",
        "blur": "8px",
        "spread": "-4px",
        "color": "#00000059"
      },
      "$description": "0 2px 8px -4px oklch(0 0 0 / 0.35); glow proibido"
    },
    "shadow-overlay": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "24px",
        "blur": "48px",
        "spread": "-12px",
        "color": "#00000080"
      },
      "$description": "shadow-2xl em Auth/Deposit — uma sombra neutra"
    }
  }
